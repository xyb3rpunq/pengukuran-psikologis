  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "webr": "^0.6.0"
  }
}
