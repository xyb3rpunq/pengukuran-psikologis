{
  "name": "pengukuran-psikologis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TERA — mesin psikometri PSI307 di peramban. Zero dependencies, terverifikasi terhadap modul kuliah.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/salin-runtime.mjs",
